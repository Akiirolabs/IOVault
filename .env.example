# IO Vault server
OPENAI_API_KEY=sk-your-key
OPENAI_AGENT_MODEL=gpt-5.6-terra
JWT_SECRET=replace-with-a-long-random-secret
CONNECTOR_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
APP_ORIGIN=http://localhost:5173

# Google Workspace OAuth (redirect URI must match the Google Cloud configuration)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8787/api/connectors/google/callback

# Code Vault model tiers
OPENAI_CODE_MODEL_BALANCED=gpt-5.4-mini
OPENAI_CODE_MODEL_BEST=gpt-5.6

# GitHub App (repository contents are never stored in these values)
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=your-iovault-app
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
