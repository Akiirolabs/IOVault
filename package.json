{
  "name": "progress-command-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node server/index.js\"",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "_comments": {
    "dev": "Starts Vite (frontend) and Express (API) together — use for local IO Vault",
    "dev:web": "Frontend only at http://localhost:5173 — AI calls need dev:api or full dev",
    "dev:api": "Express API at http://localhost:8787 — requires OPENAI_API_KEY in .env.local",
    "build": "Typecheck + production bundle to dist/",
    "preview": "Serve the production build locally"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "openai": "^6.34.0",
    "react": "latest",
    "react-dom": "latest",
    "react-icons": "^5.6.0",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
